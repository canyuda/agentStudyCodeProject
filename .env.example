# streamingAgentGateway 配置模板
# 用法：复制本文件为 .env 并填入真实值（cp .env.example .env）
# .env 已被 gitignore 不会入库；本模板文件入库供参考。
# 读取方：project/homework/streamingAgentGateway/gateway（server.py 启动时 load_dotenv，
# 命令行已 export 的同名变量优先于本文件）。

# DeepSeek API Key（GATEWAY_MODEL=deepseek 时必填；无默认值）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 模型选择：fake=本地假模型（代码默认，零依赖零 token）；deepseek=真实调用
GATEWAY_MODEL=fake

# SQLite 持久化路径（相对服务启动目录）；留空=纯内存模式（重启即空）
# 当前推荐：gateway.db = 写穿持久化 + 进程重启恢复
GATEWAY_DB=gateway.db

# DeepSeek 可选覆盖（以下即为代码内默认值，无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
